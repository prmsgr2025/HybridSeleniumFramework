<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="HybridAutomationSuite"
       parallel="methods"
       thread-count="3"
       data-provider-thread-count="3">

    <listeners>
        <listener class-name="retry.RetryTransformer"/>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <test name="BrowserLaunchTests">

        <classes>
            <class name="tests.BrowserLaunchTest"/>
            <class name="tests.WebFormTest"/>
            <class name="tests.WebFormSelectionTest"/>
            <class name="tests.JavaScriptAlertsTest"/>
            <class name="tests.FramesTest"/>
            <class name="tests.WindowsTest"/>

            <!-- Step 7: Data-driven test -->
            <class name="tests.DataDrivenWebFormTest"/>
        </classes>

    </test>

</suite>